---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaSection from '../components/CtaSection.astro';
import { services, formatPrice } from '../data/site';
---

<Layout title="Услуги" description="Косметический и капитальный ремонт, ремонт по дизайн-проекту, санузлы и электромонтаж в Москве.">
  <PageHeader title="Услуги" lead="Берём на себя весь ремонт или отдельные работы. Цены указаны за квадратный метр пола, если не сказано иное." />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <ul class="grid gap-6 md:grid-cols-2">
      {services.map((s) => (
        <li class="flex flex-col rounded-xl border border-line bg-surface p-6 sm:p-8">
          <h2 class="font-display text-xl font-semibold">{s.title}</h2>
          <p class="mt-3 leading-relaxed text-muted">{s.short}</p>
          <ul class="mt-6 flex-1 space-y-2.5">
            {s.items.map((item) => (
              <li class="flex items-start gap-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 shrink-0 text-accent" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
            <p class="text-lg font-semibold">от {formatPrice(s.from)} {s.unit ?? '₽/м²'}</p>
            <a href="#form" class="font-semibold text-accent-hover hover:underline">Рассчитать →</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <CtaSection source="Услуги" />
</Layout>
