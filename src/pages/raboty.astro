---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaSection from '../components/CtaSection.astro';
import WorkCard from '../components/WorkCard.astro';
import { works } from '../data/site';
---

<Layout title="Наши работы" description="Фото готовых ремонтов: площадь, сроки и итоговая стоимость каждого объекта.">
  <PageHeader title="Наши работы" lead="Каждый объект — с реальными сроками и итоговой стоимостью. Ни один не вышел за смету." />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {works.map((w) => <WorkCard work={w} />)}
    </div>
  </section>

  <CtaSection source="Наши работы" title="Хотите так же? Рассчитаем ваш ремонт" />
</Layout>
