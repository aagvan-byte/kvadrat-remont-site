---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaSection from '../components/CtaSection.astro';
import { prices, faq, formatPrice } from '../data/site';
---

<Layout title="Цены" description="Стоимость ремонта квартиры за квадратный метр: косметический, капитальный и дизайнерский ремонт.">
  <PageHeader title="Цены на ремонт" lead="Стоимость работ за квадратный метр пола. Точную смету составим после бесплатного замера." />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <ul class="grid gap-6 md:grid-cols-3">
      {prices.map((p) => (
        <li
          class:list={[
            'relative flex flex-col rounded-xl p-6 sm:p-8',
            p.featured ? 'bg-dark text-white shadow-xl' : 'border border-line bg-surface',
          ]}
        >
          {p.featured && (
            <span class="absolute -top-3 left-6 rounded-md bg-accent px-3 py-1 text-xs font-semibold text-ink">{p.text}</span>
          )}
          <h2 class="font-display text-xl font-semibold">{p.name}</h2>
          {!p.featured && <p class="mt-1 text-muted">{p.text}</p>}
          <p class="mt-6">
            <span class="text-sm opacity-70">от </span>
            <span class="font-display text-4xl font-semibold">{formatPrice(p.price)}</span>
            <span class="opacity-70"> ₽/м²</span>
          </p>
          <ul class="mt-8 flex-1 space-y-3">
            {p.features.map((f) => (
              <li class="flex items-start gap-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 shrink-0 text-accent" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
                {f}
              </li>
            ))}
          </ul>
          <a
            href="#form"
            class:list={[
              'mt-8 rounded-lg px-6 py-3.5 text-center font-semibold transition-colors',
              p.featured ? 'bg-accent text-ink hover:bg-accent-hover hover:text-white' : 'border border-ink/20 hover:border-ink',
            ]}
          >
            Рассчитать свою квартиру
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl">Частые вопросы</h2>
      <div class="mt-8 divide-y divide-line border-y border-line">
        {faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
              {item.q}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 transition-transform group-open:rotate-45" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </summary>
            <p class="mt-3 leading-relaxed text-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaSection source="Цены" />
</Layout>
