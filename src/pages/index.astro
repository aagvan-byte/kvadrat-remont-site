---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import WorkCard from '../components/WorkCard.astro';
import { site, stats, services, steps, works, formatPrice } from '../data/site';
---

<Layout
  title="Квадрат — ремонт квартир под ключ в Москве"
  description="Ремонт квартир под ключ с фиксированной сметой и гарантией 3 года. Бесплатный замер и расчёт стоимости."
>
  <!-- Первый экран -->
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:px-6 md:pt-24 md:pb-20">
    <p class="text-sm font-semibold tracking-wider text-accent-hover uppercase">{site.tagline} · {site.city}</p>
    <h1 class="mt-5 max-w-4xl font-display text-[1.75rem] leading-[1.15] font-semibold text-balance hyphens-auto sm:text-5xl lg:text-6xl">
      Ремонт по фиксированной смете — без сюрпризов в конце
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Сделаем ремонт квартиры под ключ: от замера до уборки. Цена и сроки закреплены в договоре, а каждый день вы получаете фотоотчёт.
    </p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="#form" class="rounded-lg bg-accent px-7 py-4 text-center font-semibold text-ink transition-colors hover:bg-accent-hover hover:text-white">
        Рассчитать стоимость
      </a>
      <a href="/raboty" class="rounded-lg border border-ink/20 px-7 py-4 text-center font-semibold transition-colors hover:border-ink">
        Смотреть наши работы
      </a>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-4">
      {stats.map((s) => (
        <div class="flex flex-col-reverse bg-surface p-6">
          <dt class="mt-1 text-muted">{s.label}</dt>
          <dd class="font-display text-2xl font-semibold sm:text-3xl">{s.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Услуги -->
  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-display text-2xl font-semibold sm:text-4xl">Что мы делаем</h2>
        <a href="/uslugi" class="font-semibold text-accent-hover hover:underline">Все услуги →</a>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {services.slice(0, 3).map((s) => (
          <li class="flex flex-col rounded-xl border border-line p-6">
            <h3 class="font-display text-lg font-semibold">{s.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{s.short}</p>
            <p class="mt-6 font-semibold">от {formatPrice(s.from)} {s.unit ?? '₽/м²'}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Как работаем -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
    <h2 class="font-display text-2xl font-semibold sm:text-4xl">Как мы работаем</h2>
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {steps.map((s, i) => (
        <li class="border-t-2 border-accent pt-5">
          <span class="font-display text-sm font-semibold text-accent-hover">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Работы -->
  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-display text-2xl font-semibold sm:text-4xl">Недавние работы</h2>
        <a href="/raboty" class="font-semibold text-accent-hover hover:underline">Все работы →</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {works.slice(0, 3).map((w) => <WorkCard work={w} />)}
      </div>
    </div>
  </section>

  <CtaSection source="Главная" />
</Layout>
