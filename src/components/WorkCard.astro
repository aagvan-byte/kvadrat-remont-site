---
interface Props {
  work: { title: string; type: string; area: number; days: number; price: string };
}

const { work } = Astro.props;
---

<article class="group overflow-hidden rounded-xl border border-line bg-surface">
  <div class="relative aspect-[4/3] overflow-hidden bg-stone-200">
    <slot name="image">
      <!-- Заглушка, пока нет фото -->
      <svg class="absolute inset-0 m-auto h-16 w-16 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" /><path d="M3 12h9v9M12 3v5" />
      </svg>
    </slot>
    <span class="absolute top-3 left-3 rounded-md bg-surface/95 px-2.5 py-1 text-xs font-semibold">{work.type}</span>
  </div>
  <div class="p-5">
    <h3 class="font-display text-base font-semibold">{work.title}</h3>
    <dl class="mt-4 grid grid-cols-3 gap-2 text-sm">
      <div class="flex flex-col-reverse"><dt class="text-muted">площадь</dt><dd class="font-semibold">{work.area} м²</dd></div>
      <div class="flex flex-col-reverse"><dt class="text-muted">срок</dt><dd class="font-semibold">{work.days} дн.</dd></div>
      <div class="flex flex-col-reverse"><dt class="text-muted">стоимость</dt><dd class="font-semibold">{work.price}</dd></div>
    </dl>
  </div>
</article>
